PORT=3000
NODE_ENV=production

CORS_ORIGINS=https://your-production-domain.com

DATABASE_URL=postgresql://user:password@host:5432/pcmazing_site

DB_SCHEMA=public
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# Role-based access control (set true when roles/permissions are finalized)
RBAC_ENABLED=false

# Persistent absolute path for uploaded images (selfies, products, etc.)
# Do NOT use ~/ — Node does not expand tilde. Use the full path.
# Example for this server layout:
UPLOADS_DIR=/home/YOUR_USER/apps/pcmazing-site/backend/uploads
