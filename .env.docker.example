# Copy on the server and fill real values:
#   cp .env.docker.example .env.docker
#   nano .env.docker
#
# Then:
#   docker compose --env-file .env.docker up -d --build
#
# Never commit .env.docker (it is gitignored).

# =============================================================================
# Public URLs (must match Cloudflare Tunnel hostnames)
# =============================================================================
# Frontend build args + browser API base
API_URL=https://v1-api.pcmazing.com
PUBLIC_SITE_URL=https://www.pcmazing.com

# Backend CORS (comma-separated frontend origins)
CORS_ORIGINS=https://www.pcmazing.com,https://pcmazing.com

# Optional build stamp (shown in app-version.json)
# BUILD_ID=

# Docker network shared with the Cloudflare tunnel container
# Confirm:
#   docker inspect <pcmazing-tunnel-container> --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
# This server uses: app-tier
DOCKER_NETWORK=app-tier

# =============================================================================
# Server
# =============================================================================
NODE_ENV=production
PORT=3000
UPLOADS_DIR=/app/uploads

# Optional: require x-setup-key on /setup routes
# SETUP_API_KEY=

# =============================================================================
# PostgreSQL
# =============================================================================
# Prefer DATABASE_URL. Host must be reachable on DOCKER_NETWORK (app-tier).
# This server: aliases are "db" and "postgres-stack-db-1" — use "db".
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/pcmazing_site

DB_HOST=db
DB_PORT=5432
DB_NAME=pcmazing_site
DB_USER=USER
DB_PASSWORD=PASSWORD
DB_SCHEMA=public
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
# DB_CONNECTION_MODE=local
# DATABASE_DIRECT_URL=

# =============================================================================
# Admin auth
# =============================================================================
ADMIN_STAFF_PASSCODE=change-me-staff-gate
ADMIN_STAFF_GATE_EXPIRES_IN=8h
JWT_SECRET=change-me-admin-jwt-long-random
JWT_EXPIRES_IN=8h

# =============================================================================
# Misc
# =============================================================================
RBAC_ENABLED=false
